# Two fixed motors and two elevons for the plane-tailsitter-dual SITL model.
Q_ENABLE         1
Q_FRAME_CLASS   10
Q_TAILSIT_ENABLE 1
Q_TAILSIT_MOTMX  0
Q_TILT_ENABLE    0
Q_TAILSIT_VHGAIN 0
Q_TAILSIT_VFGAIN 0
Q_TAILSIT_RAT_FW 20
Q_TAILSIT_RAT_VT 20
Q_TAILSIT_ANGLE  45
Q_TAILSIT_ANG_VT 60
Q_TAILSIT_THR_VT 20
Q_ASSIST_SPEED  10
RUDD_DT_GAIN   100
YAW2SRV_DAMP   0.5
SERVO1_FUNCTION 77
SERVO2_FUNCTION 78
SERVO3_FUNCTION -1
SERVO4_FUNCTION -1
SERVO5_FUNCTION 73
SERVO6_FUNCTION 74
SERVO7_FUNCTION -1
SERVO8_FUNCTION -1
SERVO5_MIN    1000
SERVO5_MAX    2000
SERVO6_MIN    1000
SERVO6_MAX    2000
Q_M_PWM_MIN   1000
Q_M_PWM_MAX   2000
# Fixed-wing gains for the enlarged control surfaces and propeller wash in this model.
RLL_RATE_FF    0.025
RLL_RATE_P     0.015
RLL_RATE_I     0.015
RLL_RATE_D     0.0005
PTCH_RATE_FF   0.02
PTCH_RATE_P    0.015
PTCH_RATE_I    0.015
PTCH_RATE_D    0.0005
# Hover gains for the same surfaces in propeller flow.
Q_A_ANG_PIT_P  3
Q_A_ANG_RLL_P  3
Q_A_ANG_YAW_P  3
# VTOL roll uses differential motor thrust in this model.
Q_A_RAT_RLL_P  0.5
Q_A_RAT_RLL_I  0.05
Q_A_RAT_RLL_D  0.01
Q_A_RAT_PIT_FF 0.05
Q_A_RAT_PIT_P  0.03
Q_A_RAT_PIT_I  0.03
Q_A_RAT_PIT_D  0.001
Q_A_RAT_YAW_FF 0.05
Q_A_RAT_YAW_P  0.03
Q_A_RAT_YAW_I  0.03
Q_A_RAT_YAW_D  0.001
